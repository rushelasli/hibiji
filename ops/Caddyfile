# Homeserver origin config (Windows 10 + Cloudflare Tunnel).
# Runs locally on 127.0.0.1:8080 — no inbound exposure; cloudflared is the
# only client. Serves mirrored build output only, never the git clones.
#
# cloudflared forwards the original Host header, so Caddy routes on it.

# Portfolio (this repo). Adjust hostname if your apex differs.
nyaahibi.web.id:8080 {
	bind 127.0.0.1
	root * C:/srv/sites/hibi
	encode gzip

	# SPA history fallback: unknown paths → index.html, assets served as-is.
	try_files {path} /index.html
	file_server

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	header Cache-Control "no-cache"
}

# Projects hub: one subdomain + path routing (/furuhibi, /nyaahibiv2, ...).
# Landing page (dist-hub) sits at the root; each site is a folder under
# C:/srv/sites/projects.
project.nyaahibi.web.id:8080 {
	bind 127.0.0.1
	root * C:/srv/sites/projects
	encode gzip
	try_files {path} /index.html
	file_server

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	header Cache-Control "no-cache"
}
